    <script>
        // =============================================
        // STORAGE FUNCTIONS
        // =============================================
        
        function save(key, val) {
            try {
                if (typeof Android !== 'undefined' && Android.saveData) {
                    Android.saveData(key, val);
                } else {
                    localStorage.setItem(key, val);
                }
            } catch(e) { console.error(e); }
        }

        function load(key) {
            try {
                if (typeof Android !== 'undefined' && Android.loadData) {
                    return Android.loadData(key) || '';
                }
                return localStorage.getItem(key) || '';
            } catch(e) { return ''; }
        }

        // =============================================
        // STATE
        // =============================================
        
        let entries = [];          // Spaced repetition journal
        let diaryEntries = [];     // Daily diary (separate)
        let tasks = [];
        let activities = [];
        let notes = [];
        let editNoteId = null;
        let pendingEntry = null;
        let captcha = { a: 0, b: 0 };
        let selectedCat = 'all';
        let selectedMood = '😊';
        let editMood = '😊';

        // =============================================
        // INIT
        // =============================================
        
        document.addEventListener('DOMContentLoaded', () => {
            loadAll();
            initTabs();
            initNotePreview();
            updateCountdown();
            setInterval(updateCountdown, 60000);
        });

        function loadAll() {
            entries = JSON.parse(load('entries') || '[]');
            diaryEntries = JSON.parse(load('diaryEntries') || '[]');
            tasks = JSON.parse(load('tasks') || '[]');
            activities = JSON.parse(load('freeActivities') || '[]');
            notes = JSON.parse(load('notes') || '[]');

            // Dark mode
            if (load('darkMode') === 'true') {
                document.body.classList.add('dark');
                document.getElementById('darkToggle').classList.add('active');
            }

            // Sleep settings
            document.getElementById('sleepStart').value = load('sleepStart') || '22:00';
            document.getElementById('sleepEnd').value = load('sleepEnd') || '06:00';

            // Theme color
            const color = load('themeColor') || '#6366f1';
            document.getElementById('themeColor').value = color;
            document.documentElement.style.setProperty('--primary', color);
            document.querySelector('.header').style.background = color;

            renderAll();
        }

        function renderAll() {
            renderJournal();
            renderDiary();
            renderTasks();
            renderActivities();
            renderNotes();
            updateStats();
        }

        // =============================================
        // TABS
        // =============================================
        
        function initTabs() {
            document.querySelectorAll('.tab').forEach(tab => {
                tab.addEventListener('click', () => {
                    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                    document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
                    document.getElementById(tab.dataset.tab).classList.add('active');
                    if (tab.dataset.tab === 'stats') updateStats();
                });
            });
        }

        // =============================================
        // MODALS
        // =============================================
        
        function openModal(id) {
            document.getElementById(id).classList.add('active');
            closeFab();
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        document.addEventListener('click', e => {
            if (e.target.classList.contains('modal-overlay')) {
                e.target.classList.remove('active');
            }
        });

        // =============================================
        // FAB
        // =============================================
        
        function toggleFab() {
            const fab = document.getElementById('fabBtn');
            const menu = document.getElementById('fabMenu');
            fab.classList.toggle('open');
            menu.classList.toggle('open');
        }

        function closeFab() {
            document.getElementById('fabBtn').classList.remove('open');
            document.getElementById('fabMenu').classList.remove('open');
        }

        // =============================================
        // JOURNAL (SPACED REPETITION)
        // =============================================
        
        function openAddJournal() {
            document.getElementById('journalModalTitle').textContent = '📔 New Journal Entry';
            document.getElementById('journalContent').value = '';
            document.getElementById('journalDate').value = '';
            openModal('journalModal');
        }

        function saveJournal() {
            const content = document.getElementById('journalContent').value.trim();
            const dateVal = document.getElementById('journalDate').value;
            
            if (!content) return alert('Please write something!');
            
            const today = new Date().toISOString().split('T')[0];
            const date = dateVal || today;

            if (dateVal && dateVal < today) {
                pendingEntry = { content, date };
                showCaptcha();
                return;
            }

            createEntry(content, date);
        }

        function createEntry(content, date) {
            entries.unshift({
                id: Date.now(),
                content,
                date,
                createdAt: new Date().toISOString()
            });
            save('entries', JSON.stringify(entries));
            closeModal('journalModal');
            renderJournal();
            updateStats();
        }

        function showCaptcha() {
            captcha.a = Math.floor(Math.random() * 20) + 1;
            captcha.b = Math.floor(Math.random() * 20) + 1;
            document.getElementById('captchaQ').textContent = `${captcha.a} + ${captcha.b} = ?`;
            document.getElementById('captchaAnswer').value = '';
            closeModal('journalModal');
            openModal('captchaModal');
        }

        function verifyCaptcha() {
            const ans = parseInt(document.getElementById('captchaAnswer').value);
            if (ans === captcha.a + captcha.b) {
                closeModal('captchaModal');
                if (pendingEntry) {
                    createEntry(pendingEntry.content, pendingEntry.date);
                    pendingEntry = null;
                }
            } else {
                alert('Wrong answer!');
            }
        }

        function renderJournal() {
            const list = document.getElementById('journalList');
            const revList = document.getElementById('revisionList');
            const revAlert = document.getElementById('revisionAlert');

            // Spaced repetition check
            const today = new Date(); today.setHours(0,0,0,0);
            const revDays = [1, 3, 7, 14, 30];
            const revDue = entries.filter(e => {
                const d = new Date(e.date); d.setHours(0,0,0,0);
                const diff = Math.floor((today - d) / 86400000);
                return revDays.includes(diff);
            });

            if (revDue.length > 0) {
                revAlert.style.display = 'block';
                revList.innerHTML = revDue.map(e => {
                    const d = new Date(e.date); d.setHours(0,0,0,0);
                    const diff = Math.floor((today - d) / 86400000);
                    return `
                        <div class="card" style="border-left:3px solid var(--warning);">
                            <div class="badge badge-medium" style="margin-bottom:8px;">${diff} days ago</div>
                            <div class="card-body">${esc(e.content)}</div>
                        </div>
                    `;
                }).join('');
            } else {
                revAlert.style.display = 'none';
            }

            if (entries.length === 0) {
                list.innerHTML = `
                    <div class="empty">
                        <div class="empty-icon">📔</div>
                        <h3>No entries yet</h3>
                        <p>Tap + to write your first journal entry</p>
                    </div>
                `;
                return;
            }

            // Group by date
            const sorted = [...entries].sort((a,b) => new Date(b.date) - new Date(a.date));
            const groups = {};
            sorted.forEach(e => {
                if (!groups[e.date]) groups[e.date] = [];
                groups[e.date].push(e);
            });

            let html = '';
            for (const [date, items] of Object.entries(groups)) {
                html += `<div class="group-header">${formatDate(date)}</div>`;
                items.forEach(e => {
                    html += `
                        <div class="card">
                            <div class="card-body">${esc(e.content)}</div>
                            <div class="card-footer">
                                <button class="btn btn-ghost btn-sm" onclick="editJournal(${e.id})">✏️ Edit</button>
                                <button class="btn btn-danger btn-sm" onclick="deleteJournal(${e.id})">🗑️ Delete</button>
                            </div>
                        </div>
                    `;
                });
            }
            list.innerHTML = html;
        }

        function editJournal(id) {
            const e = entries.find(x => x.id === id);
            if (e) {
                document.getElementById('editJournalContent').value = e.content;
                document.getElementById('editJournalId').value = id;
                openModal('editJournalModal');
            }
        }

        function updateJournal() {
            const id = parseInt(document.getElementById('editJournalId').value);
            const content = document.getElementById('editJournalContent').value.trim();
            if (!content) return alert('Cannot be empty!');
            
            const e = entries.find(x => x.id === id);
            if (e) {
                e.content = content;
                save('entries', JSON.stringify(entries));
                closeModal('editJournalModal');
                renderJournal();
            }
        }

        function deleteJournal(id) {
            confirm('Delete this journal entry?', () => {
                entries = entries.filter(e => e.id !== id);
                save('entries', JSON.stringify(entries));
                renderJournal();
                updateStats();
            });
        }

        // =============================================
        // DAILY DIARY (SEPARATE - NO SPACED REPETITION)
        // =============================================

        function selectMood(mood) {
            selectedMood = mood;
            document.querySelectorAll('#moodSelector .mood-btn').forEach(btn => {
                btn.classList.remove('selected');
                if (btn.dataset.mood === mood) btn.classList.add('selected');
            });
        }

        function selectEditMood(mood) {
            editMood = mood;
            document.querySelectorAll('#editMoodSelector .mood-btn').forEach(btn => {
                btn.classList.remove('selected');
                if (btn.dataset.mood === mood) btn.classList.add('selected');
            });
        }

        function openAddDiary() {
            document.getElementById('diaryModalTitle').textContent = '📖 Daily Diary';
            document.getElementById('diaryTitle').value = '';
            document.getElementById('diaryContent').value = '';
            selectedMood = '😊';
            document.querySelectorAll('#moodSelector .mood-btn').forEach(btn => {
                btn.classList.remove('selected');
                if (btn.dataset.mood === '😊') btn.classList.add('selected');
            });
            openModal('diaryModal');
        }

        function saveDiary() {
            const title = document.getElementById('diaryTitle').value.trim() || 'Untitled Entry';
            const content = document.getElementById('diaryContent').value.trim();
            
            if (!content) return alert('Please write something!');

            const today = new Date().toISOString().split('T')[0];
            
            diaryEntries.unshift({
                id: Date.now(),
                title,
                content,
                mood: selectedMood,
                date: today,
                createdAt: new Date().toISOString()
            });

            save('diaryEntries', JSON.stringify(diaryEntries));
            closeModal('diaryModal');
            renderDiary();
            updateStats();
        }

        function renderDiary() {
            const list = document.getElementById('diaryList');

            if (diaryEntries.length === 0) {
                list.innerHTML = `
                    <div class="empty">
                        <div class="empty-icon">📖</div>
                        <h3>No diary entries yet</h3>
                        <p>Tap + to write about your day</p>
                    </div>
                `;
                return;
            }

            // Group by date
            const sorted = [...diaryEntries].sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt));
            const groups = {};
            sorted.forEach(e => {
                if (!groups[e.date]) groups[e.date] = [];
                groups[e.date].push(e);
            });

            let html = '';
            for (const [date, items] of Object.entries(groups)) {
                html += `<div class="group-header">${formatDate(date)}</div>`;
                items.forEach(e => {
                    html += `
                        <div class="diary-card">
                            <div class="diary-title">
                                <span class="diary-mood">${e.mood}</span>
                                <span>${esc(e.title)}</span>
                            </div>
                            <div class="card-meta" style="margin-bottom:8px;">${formatTime(e.createdAt)}</div>
                            <div class="card-body">${esc(e.content)}</div>
                            <div class="card-footer">
                                <button class="btn btn-ghost btn-sm" onclick="editDiary(${e.id})">✏️ Edit</button>
                                <button class="btn btn-danger btn-sm" onclick="deleteDiary(${e.id})">🗑️ Delete</button>
                            </div>
                        </div>
                    `;
                });
            }
            list.innerHTML = html;
        }

        function editDiary(id) {
            const e = diaryEntries.find(x => x.id === id);
            if (e) {
                document.getElementById('editDiaryTitle').value = e.title;
                document.getElementById('editDiaryContent').value = e.content;
                document.getElementById('editDiaryId').value = id;
                editMood = e.mood;
                document.querySelectorAll('#editMoodSelector .mood-btn').forEach(btn => {
                    btn.classList.remove('selected');
                    if (btn.dataset.mood === e.mood) btn.classList.add('selected');
                });
                openModal('editDiaryModal');
            }
        }

        function updateDiary() {
            const id = parseInt(document.getElementById('editDiaryId').value);
            const title = document.getElementById('editDiaryTitle').value.trim() || 'Untitled Entry';
            const content = document.getElementById('editDiaryContent').value.trim();
            
            if (!content) return alert('Cannot be empty!');
            
            const e = diaryEntries.find(x => x.id === id);
            if (e) {
                e.title = title;
                e.content = content;
                e.mood = editMood;
                save('diaryEntries', JSON.stringify(diaryEntries));
                closeModal('editDiaryModal');
                renderDiary();
            }
        }

        function deleteDiary(id) {
            confirm('Delete this diary entry?', () => {
                diaryEntries = diaryEntries.filter(e => e.id !== id);
                save('diaryEntries', JSON.stringify(diaryEntries));
                renderDiary();
                updateStats();
            });
        }

        // =============================================
        // TASKS
        // =============================================
        
        function openAddTask() {
            document.getElementById('taskName').value = '';
            document.getElementById('taskHours').value = '';
            document.getElementById('taskPriority').value = 'medium';
            openModal('taskModal');
        }

        function saveTask() {
            const name = document.getElementById('taskName').value.trim();
            const hours = parseFloat(document.getElementById('taskHours').value) || 0;
            const priority = document.getElementById('taskPriority').value;

            if (!name) return alert('Enter task name!');

            tasks.push({
                id: Date.now(),
                name,
                hours,
                priority,
                done: false,
                createdAt: new Date().toISOString()
            });

            save('tasks', JSON.stringify(tasks));
            closeModal('taskModal');
            renderTasks();
            updateStats();
        }

        function toggleTask(id) {
            const t = tasks.find(x => x.id === id);
            if (t) {
                t.done = !t.done;
                save('tasks', JSON.stringify(tasks));
                renderTasks();
                updateStats();
            }
        }

        function deleteTask(id) {
            confirm('Delete this task?', () => {
                tasks = tasks.filter(t => t.id !== id);
                save('tasks', JSON.stringify(tasks));
                renderTasks();
                updateStats();
            });
        }

        function renderTasks() {
            const list = document.getElementById('taskList');
            const sort = document.getElementById('taskSort').value;

            let sorted = [...tasks];
            if (sort === 'priority') {
                const order = { high: 0, medium: 1, low: 2 };
                sorted.sort((a,b) => {
                    if (a.done !== b.done) return a.done ? 1 : -1;
                    return order[a.priority] - order[b.priority];
                });
            } else {
                sorted.sort((a,b) => a.done - b.done);
            }

            if (sorted.length === 0) {
                list.innerHTML = `
                    <div class="empty">
                        <div class="empty-icon">✅</div>
                        <h3>No tasks</h3>
                        <p>Tap + to add your first task</p>
                    </div>
                `;
            } else {
                list.innerHTML = sorted.map(t => `
                    <div class="task-item ${t.done ? 'done' : ''}">
                        <div class="checkbox ${t.done ? 'checked' : ''}" onclick="toggleTask(${t.id})">
                            ${t.done ? '✓' : ''}
                        </div>
                        <div class="task-content">
                            <div class="task-name">${esc(t.name)}</div>
                            <div class="task-info">
                                <span class="badge badge-${t.priority}">${t.priority}</span>
                                <span>⏱️ ${t.hours}h</span>
                            </div>
                        </div>
                        <button class="btn btn-ghost btn-sm" onclick="deleteTask(${t.id})" style="color:var(--danger);">🗑️</button>
                    </div>
                `).join('');
            }

            // Update stats
            const remaining = tasks.filter(t => !t.done).length;
            const totalH = tasks.filter(t => !t.done).reduce((s,t) => s + t.hours, 0);
            document.getElementById('taskCount').textContent = remaining;
            document.getElementById('totalHours').textContent = totalH.toFixed(1) + 'h';
            updateFreeTime();
        }

        // =============================================
        // ACTIVITIES
        // =============================================
        
        function openAddActivity() {
            document.getElementById('activityName').value = '';
            document.getElementById('activityHours').value = '';
            openModal('activityModal');
        }

        function saveActivity() {
            const name = document.getElementById('activityName').value.trim();
            const hours = parseFloat(document.getElementById('activityHours').value) || 0;

            if (!name) return alert('Enter activity name!');

            activities.push({ id: Date.now(), name, hours });
            save('freeActivities', JSON.stringify(activities));
            closeModal('activityModal');
            renderActivities();
            updateFreeTime();
            updateStats();
        }

        function deleteActivity(id) {
            activities = activities.filter(a => a.id !== id);
            save('freeActivities', JSON.stringify(activities));
            renderActivities();
            updateFreeTime();
            updateStats();
        }

        function renderActivities() {
            const list = document.getElementById('activityList');
            if (activities.length === 0) {
                list.innerHTML = '<p style="color:var(--text-light);text-align:center;padding:20px;">No activities planned</p>';
                return;
            }
            list.innerHTML = activities.map(a => `
                <div class="activity-item">
                    <span>${esc(a.name)}</span>
                    <span>${a.hours}h</span>
                    <button class="btn btn-ghost btn-sm" onclick="deleteActivity(${a.id})">×</button>
                </div>
            `).join('');
        }

        function updateFreeTime() {
            const sleepStart = document.getElementById('sleepStart').value || '22:00';
            const [h, m] = sleepStart.split(':').map(Number);
            const now = new Date();
            let sleep = new Date(); sleep.setHours(h, m, 0, 0);
            if (sleep <= now) sleep.setDate(sleep.getDate() + 1);

            const hoursLeft = (sleep - now) / 3600000;
            const taskH = tasks.filter(t => !t.done).reduce((s,t) => s + t.hours, 0);
            const actH = activities.reduce((s,a) => s + a.hours, 0);
            const free = Math.max(0, hoursLeft - taskH - actH);

            document.getElementById('freeTime').textContent = free.toFixed(1) + 'h';
        }

        function updateCountdown() {
            const sleepStart = document.getElementById('sleepStart').value || '22:00';
            const [h, m] = sleepStart.split(':').map(Number);
            const now = new Date();
            let sleep = new Date(); sleep.setHours(h, m, 0, 0);
            if (sleep <= now) sleep.setDate(sleep.getDate() + 1);

            const diff = sleep - now;
            const hrs = Math.floor(diff / 3600000);
            const mins = Math.floor((diff % 3600000) / 60000);
            document.getElementById('countdown').textContent = `${hrs}h ${mins}m`;
            updateFreeTime();
        }

        // =============================================
        // NOTES
        // =============================================
        
        function openAddNote() {
            editNoteId = null;
            document.getElementById('noteModalTitle').textContent = '📝 New Note';
            document.getElementById('noteTitle').value = '';
            document.getElementById('noteCategory').value = '';
            document.getElementById('noteContent').value = '';
            document.getElementById('notePreview').innerHTML = 'Preview appears here...';
            openModal('noteModal');
        }

        function initNotePreview() {
            document.getElementById('noteContent').addEventListener('input', e => {
                document.getElementById('notePreview').innerHTML = parseMD(e.target.value);
            });
        }

        function parseMD(txt) {
            if (!txt) return '<span style="color:var(--text-light)">Preview appears here...</span>';
            let h = esc(txt);
            h = h.replace(/^### (.+)$/gm, '<h3>$1</h3>');
            h = h.replace(/^## (.+)$/gm, '<h2>$1</h2>');
            h = h.replace(/^# (.+)$/gm, '<h1>$1</h1>');
            h = h.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
            h = h.replace(/\*(.+?)\*/g, '<em>$1</em>');
            h = h.replace(/__(.+?)__/g, '<u>$1</u>');
            h = h.replace(/- \[x\] (.+)/gi, '<div><input type="checkbox" checked disabled> $1</div>');
            h = h.replace(/- \[ \] (.+)/g, '<div><input type="checkbox" disabled> $1</div>');
            h = h.replace(/^- (.+)$/gm, '<li>$1</li>');
            h = h.replace(/(<li>[\s\S]*?<\/li>)/g, '<ul>$1</ul>');
            h = h.replace(/\n/g, '<br>');
            return h;
        }

        function saveNote() {
            const title = document.getElementById('noteTitle').value.trim();
            const category = document.getElementById('noteCategory').value.trim() || 'General';
            const content = document.getElementById('noteContent').value.trim();

            if (!title) return alert('Enter a title!');

            if (editNoteId) {
                const n = notes.find(x => x.id === editNoteId);
                if (n) {
                    n.title = title;
                    n.category = category;
                    n.content = content;
                    n.updatedAt = new Date().toISOString();
                }
            } else {
                notes.unshift({
                    id: Date.now(),
                    title,
                    category,
                    content,
                    createdAt: new Date().toISOString()
                });
            }

            save('notes', JSON.stringify(notes));
            closeModal('noteModal');
            renderNotes();
            updateStats();
        }

        function editNote(id) {
            const n = notes.find(x => x.id === id);
            if (n) {
                editNoteId = id;
                document.getElementById('noteModalTitle').textContent = '✏️ Edit Note';
                document.getElementById('noteTitle').value = n.title;
                document.getElementById('noteCategory').value = n.category;
                document.getElementById('noteContent').value = n.content;
                document.getElementById('notePreview').innerHTML = parseMD(n.content);
                openModal('noteModal');
            }
        }

        function deleteNote(id) {
            confirm('Delete this note?', () => {
                notes = notes.filter(n => n.id !== id);
                save('notes', JSON.stringify(notes));
                renderNotes();
                updateStats();
            });
        }

        function filterCat(cat) {
            selectedCat = cat;
            renderNotes();
        }

        function renderNotes() {
            const list = document.getElementById('notesList');
            const chips = document.getElementById('categoryChips');

            // Categories
            const cats = ['all', ...new Set(notes.map(n => n.category))];
            chips.innerHTML = cats.map(c => `
                <button class="chip ${selectedCat === c ? 'active' : ''}" onclick="filterCat('${c}')">
                    ${c === 'all' ? '📚 All' : esc(c)}
                </button>
            `).join('');

            // Filter
            let filtered = notes;
            if (selectedCat !== 'all') {
                filtered = notes.filter(n => n.category === selectedCat);
            }

            if (filtered.length === 0) {
                list.innerHTML = `
                    <div class="empty">
                        <div class="empty-icon">📝</div>
                        <h3>No notes</h3>
                        <p>Tap + to create your first note</p>
                    </div>
                `;
                return;
            }

            list.innerHTML = filtered.map(n => `
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">${esc(n.title)}</div>
                            <div class="card-meta">${timeAgo(n.createdAt)}</div>
                        </div>
                        <span class="badge badge-info">${esc(n.category)}</span>
                    </div>
                    <div class="md-preview" style="max-height:100px;overflow:hidden;">
                        ${parseMD(n.content)}
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-ghost btn-sm" onclick="editNote(${n.id})">✏️ Edit</button>
                        <button class="btn btn-danger btn-sm" onclick="deleteNote(${n.id})">🗑️ Delete</button>
                    </div>
                </div>
            `).join('');
        }

        // =============================================
        // STATS
        // =============================================
        
        function updateStats() {
            document.getElementById('statTasks').textContent = tasks.length;
            document.getElementById('statCompleted').textContent = tasks.filter(t => t.done).length;
            document.getElementById('statJournal').textContent = entries.length;
            document.getElementById('statDiary').textContent = diaryEntries.length;
            document.getElementById('statNotes').textContent = notes.length;

            const rate = tasks.length > 0 
                ? Math.round((tasks.filter(t => t.done).length / tasks.length) * 100)
                : 0;
            document.getElementById('completionRate').textContent = rate + '%';

            // Category breakdown
            const cats = {};
            notes.forEach(n => cats[n.category] = (cats[n.category] || 0) + 1);
            const catDiv = document.getElementById('categoryBreakdown');
            if (Object.keys(cats).length === 0) {
                catDiv.innerHTML = '<p style="color:var(--text-light);">No notes yet</p>';
            } else {
                catDiv.innerHTML = Object.entries(cats).map(([c, count]) => `
                    <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);">
                        <span>${esc(c)}</span>
                        <span style="font-weight:600;">${count}</span>
                    </div>
                `).join('');
            }
        }

        // =============================================
        // SETTINGS
        // =============================================
        
        function toggleDarkMode() {
            const toggle = document.getElementById('darkToggle');
            document.body.classList.toggle('dark');
            toggle.classList.toggle('active');
            save('darkMode', document.body.classList.contains('dark').toString());
        }

        function saveSleepSettings() {
            save('sleepStart', document.getElementById('sleepStart').value);
            save('sleepEnd', document.getElementById('sleepEnd').value);
            updateCountdown();
        }

        function changeTheme() {
            const color = document.getElementById('themeColor').value;
            document.documentElement.style.setProperty('--primary', color);
            document.querySelector('.header').style.background = color;
            save('themeColor', color);
        }

        // =============================================
        // CONFIRM DIALOG
        // =============================================
        
        function confirm(msg, callback) {
            document.getElementById('confirmMsg').textContent = msg;
            document.getElementById('confirmBtn').onclick = () => {
                callback();
                closeModal('confirmModal');
            };
            openModal('confirmModal');
        }

        // =============================================
        // HELPERS
        // =============================================
        
        function esc(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function formatDate(str) {
            return new Date(str).toLocaleDateString(undefined, {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
        }

        function formatTime(iso) {
            return new Date(iso).toLocaleTimeString(undefined, {
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function timeAgo(iso) {
            const diff = Date.now() - new Date(iso);
            const mins = Math.floor(diff / 60000);
            if (mins < 1) return 'Just now';
            if (mins < 60) return mins + 'm ago';
            const hrs = Math.floor(mins / 60);
            if (hrs < 24) return hrs + 'h ago';
            const days = Math.floor(hrs / 24);
            if (days < 7) return days + 'd ago';
            return new Date(iso).toLocaleDateString();
        }
    </script>
</body>
</html>